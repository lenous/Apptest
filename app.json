{
  "expo": {
    "name": "Aplikace pro výrobu",
    "slug": "aplikace-pro-vyrobu",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aplikace-pro-vyrobu",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a56db"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cz.lenous.aplikaceprovirobu"
    },
    "android": {
      "package": "cz.lenous.aplikaceprovirobu"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-document-picker",
        { "iCloudContainerEnvironment": "Production" }
      ]
    ],
    "experiments": {
      "baseUrl": "/Apptest",
      "typedRoutes": true
    }
  }
}
